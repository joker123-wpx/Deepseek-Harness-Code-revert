# Development links created by the harness, never part of the package.
node_modules/

# Test scratch space (each probe creates and removes its own throwaway tree).
test/.tmp/

# The offline preview is regenerated by `node test/live-forensics.mjs` and
# embeds one machine's real checkpoint data, so it is not committed.
preview/

# Local scratch and logs
*.log
.tmp-*
.DS_Store
Thumbs.db
